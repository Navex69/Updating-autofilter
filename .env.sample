# Telegram API credentials — https://my.telegram.org
API_ID=
API_HASH=

# BotFather token
BOT_TOKEN=

# Space-separated Telegram user IDs allowed to run /index and /stats
ADMINS=

# MongoDB connection string (Atlas free tier works fine)
DATABASE_URI=
DATABASE_NAME=AutofilterBot
COLLECTION_NAME=files

# Space-separated channel IDs (e.g. -1001234567890 -1009876543210) the bot
# indexes from. The bot must be an admin/member of every channel listed.
CHANNELS=

# true/false — turn private-chat search on or off without touching code
ENABLE_PM_SEARCH=true

# How many result buttons per page
RESULTS_PER_PAGE=8

# Ignore search text shorter than this many characters
MIN_QUERY_LEN=2

# Optional: channel the bot posts indexing-job summaries to
LOG_CHANNEL=

# Request channel - where user file requests are sent to admins
REQUEST_CHANNEL=-1003073036876

# File not found channel - where timeout notifications are sent
NOT_FOUND_FILE_CHANNEL=-1003073036876

# Auto-request timeout - seconds before auto-sending request when user doesn't interact
SUGGESTION_TIMEOUT=120

# Port the health-check web server binds — Koyeb sets this automatically
PORT=8080
